# DIntelliHub Environment Variables Template
# Copy this file to .env and fill in your values

# ========================================
# Application Settings
# ========================================
APP_NAME=DIntelliHub
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ========================================
# Database Settings (PostgreSQL)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=gravitino
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Database URL (for SQLAlchemy)
DATABASE_URL=postgresql://admin:admin123@localhost:5432/gravitino

# ========================================
# Object Storage Settings (MinIO/S3)
# ========================================
# MinIO settings (development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# Bucket names
MINIO_BUCKET_RAW=dintellihub-raw
MINIO_BUCKET_PROCESSED=dintellihub-processed
MINIO_BUCKET_VECTORS=dintellihub-vectors
MINIO_BUCKET_MODELS=dintellihub-models
MINIO_BUCKET_BACKUPS=dintellihub-backups

# S3 settings (production) - uncomment to use
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-west-2
# S3_BUCKET=dintellihub-data
# AWS_ENDPOINT_URL=https://s3.amazonaws.com

# ========================================
# Vector Database Settings (LanceDB)
# ========================================
LANCEDB_URI=/data/lancedb
# Or use remote LanceDB server:
# LANCEDB_URI=http://localhost:8080

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ========================================
# Cache Settings (Redis)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ========================================
# Monitoring Settings
# ========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9091

# ========================================
# Security Settings
# ========================================
# JWT Settings
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Password Settings
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true

# ========================================
# Daft Settings
# ========================================
DAFT_RAY_ADDRESS=local  # or ray://localhost:10001 for remote Ray
DAFT_WORKERS=4
DAFT_MEMORY_LIMIT=16GB

# ========================================
# Data Processing Settings
# ========================================
# Batch processing
BATCH_SIZE=1000
MAX_WORKERS=4
PROCESSING_TIMEOUT=3600

# Data quality
QUALITY_CHECK_ENABLED=true
QUALITY_MIN_SCORE=0.5
QUALITY_MAX_DUPLICATES=0.1

# ========================================
# AI/ML Settings
# ========================================
# OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Cohere (optional)
# COHERE_API_KEY=your_cohere_api_key
# COHERE_MODEL=embed-english-v3.0

# ========================================
# Development Settings
# ========================================
# Auto-reload (for development)
AUTO_RELOAD=true
HOT_RELOAD=true

# Debug settings
DEBUG_PROFILING_ENABLED=false
DEBUG_TRACING_ENABLED=false

# ========================================
# Testing Settings
# ========================================
TEST_DATABASE_URL=postgresql://admin:admin123@localhost:5432/gravitino_test
TEST_MINIO_ENDPOINT=localhost:9000
TEST_LANCEDB_URI=/tmp/test_lancedb

# ========================================
# Logging Settings
# ========================================
LOG_FORMAT=json
LOG_OUTPUT=stdout  # or file
LOG_FILE=/var/log/dintellihub/app.log
LOG_ROTATION=50MB
LOG_RETENTION=30 days

# Structured logging
STRUCTURED_LOGGING=true
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_TRACEBACK=true

# ========================================
# CORS Settings
# ========================================
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ========================================
# Rate Limiting Settings
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ========================================
# Feature Flags
# ========================================
FEATURE_ENABLE_AUTH=true
FEATURE_ENABLE_RATE_LIMIT=true
FEATURE_ENABLE_METRICS=true
FEATURE_ENABLE_TRACING=false
FEATURE_ENABLE_CACHE=true
