# Arrow Lake — GPU Variant Dockerfile
#
# Extends the CPU build with CUDA runtime + cu124 PyTorch.
# Build:  docker build -f deploy/Dockerfile.gpu -t arrow-lake:gpu .
# Run:    docker run --gpus all arrow-lake:gpu python -c "import torch; print(torch.cuda.is_available())"

# ==============================================================================
# Stage 1 — builder (GPU)
# ==============================================================================
FROM --platform=$BUILDPLATFORM python:3.12-slim AS builder

ARG TARGETARCH

# System dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    git \
    libcurl4-openssl-dev \
    libssl-dev \
    libgrpc++-dev \
    protobuf-compiler \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /build

# Copy dependency manifests and source (hatchling needs README.md at build time)
COPY pyproject.toml README.md ./
COPY arrow_lake/ arrow_lake/
COPY flows/ flows/

# Create venv and install all dependencies (with BuildKit cache)
# Full extras（含 docling）— 与 CPU Dockerfile 对齐；gpu extra 此处不加（下方换 cu124 torch）
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv .venv \
    && . .venv/bin/activate \
    && uv pip install --no-cache-dir ".[fts,otel,rag,he,document,docling,chunking-full,dedup,nemo-curator,gpu]" \
    && uv pip install --no-cache-dir jupyterlab ipywidgets \
    && uv pip install --no-cache-dir modelscope>=1.18 PyJWT "apache-gravitino==1.2.1" "boto3==1.43.0" "botocore==1.43.0"

# Replace CPU torch with CUDA 12.4 variant
RUN --mount=type=cache,target=/root/.cache/uv \
    . .venv/bin/activate \
    && uv pip install --no-cache-dir --force-reinstall \
    torch --index-url https://download.pytorch.org/whl/cu124

# ==============================================================================
# Stage 2 — runtime (GPU)
# ==============================================================================
# v1.9.6: 改用 python:3.12-slim base（同 CPU）。原 nvidia/cuda base 无系统 python，
# 靠 uv install standalone → relocation 崩（找不到 stdlib encodings）。
# python:3.12-slim 自带系统 python（含 stdlib），venv 直接用。
# CUDA 支持不依赖 nvidia/cuda base：torch cu124 wheel 自带 nvidia-*-cu12 runtime libs，
# GPU 驱动由 host --gpus all 注入（标准 PyTorch Docker 做法）。
FROM python:3.12-slim AS runtime

LABEL maintainer="wits@sunpw.dev"
LABEL description="Arrow Lake GPU — Multimodal data lakehouse with CUDA support"
LABEL org.opencontainers.image.source="https://github.com/wits-sunpw/arrow-lake"

# Install uv for Python management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Runtime system dependencies (Ubuntu packages)
# 含 docling/opencv 运行时依赖（libgl1 等），与 CPU Dockerfile 对齐
# v1.9.6: 切 apt 到 aliyun mirror（避免代理 17887→deb.debian.org 502 Bad Gateway，同 CPU Dockerfile）
RUN for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
        [ -f "$f" ] && sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' "$f" || true; \
    done \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libcurl4 \
    libgomp1 \
    libssl3 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    libxft2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxi6 \
    libxtst6 \
    libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

# v1.9.6: 删 uv standalone python（relocation 崩）+ symlink。
# python:3.12-slim base 自带系统 python（/usr/local/bin/python3，含 stdlib），venv 直接用。

# Create non-root user
RUN groupadd -r arrowlake && useradd -r -g arrowlake -d /app -s /sbin/nologin arrowlake

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /build/.venv /app/.venv

# Fix shebangs: builder venv paths (/build/.venv) → runtime (/app/.venv)
RUN find /app/.venv/bin/ -type f -exec sed -i '1s|^#!/build/.venv/bin/python3|#!/app/.venv/bin/python3|' {} +

# Copy installed package source
COPY --from=builder /build/arrow_lake /app/arrow_lake
COPY --from=builder /build/flows /app/flows

# Copy examples for testing / demos
COPY examples/ /app/examples/

# v1.9.6: bake reranker + docling models (offline-ready) — same as CPU Dockerfile.
# Sources: msmodels (modelscope reranker) + hfmodels (HF docling). Supply via
# buildx --build-context msmodels=... --build-context hfmodels=...
COPY --from=msmodels BAAI--bge-reranker-v2-m3/snapshots/master /opt/models/bge-reranker-v2-m3
COPY --from=hfmodels models--docling-project--docling-layout-heron \
     models--docling-project--docling-models /opt/hf-cache/hub/

# Activate venv in PATH
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app" \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    NVIDIA_VISIBLE_DEVICES="all" \
    NVIDIA_DRIVER_CAPABILITIES="compute,utility" \
    ARROW_LAKE__COMPUTE__GPU_ENABLED="true" \
    HF_HOME="/opt/hf-cache" \
    HF_HUB_OFFLINE="1"

# Install mc (MinIO Client) for health checks
RUN curl -sL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc

EXPOSE 8000

# Run as non-root user
USER arrowlake

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["curl", "-sf", "http://localhost:8000/health"]

CMD ["uvicorn", "arrow_lake.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
