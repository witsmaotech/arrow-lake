# Arrow Lake Environment Configuration
# Copy this file as .env and modify values:
#   cp .env.example .env
#
# Or use the Makefile helper:
#   make env

# ==============================================================================
# Docker Compose — Service Startup
# ==============================================================================

# Compose profiles to activate (space-separated)
# Available: core, compute, dev, gpu, monitoring, kg, ocr
COMPOSE_PROFILES=

# ==============================================================================
# Docker Compose — API Server
# ==============================================================================

API_PORT=8000
API_MEMORY_LIMIT=2G
API_CPU_LIMIT=1.0

# ==============================================================================
# Docker Compose — MinIO Object Storage
# ==============================================================================

MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=arrow-lake
MINIO_MEMORY_LIMIT=1G
MINIO_CPU_LIMIT=0.5

# ==============================================================================
# Docker Compose — Ray Cluster
# ==============================================================================

RAY_HEAD_CPUS=2
RAY_HEAD_MEMORY_LIMIT=4G
RAY_HEAD_CPU_LIMIT=2.0
RAY_WORKER_REPLICAS=1
RAY_WORKER_CPUS=2
RAY_WORKER_MEMORY=4G
RAY_WORKER_CPU_LIMIT=2.0

# ==============================================================================
# Docker Compose — GPU (requires NVIDIA Container Toolkit)
# ==============================================================================

GPU_COUNT_PER_HEAD=1
GPU_COUNT_PER_WORKER=1

# ==============================================================================
# Docker Compose — Jupyter Lab
# ==============================================================================

JUPYTER_PORT=8888
JUPYTER_MEMORY_LIMIT=2G
JUPYTER_CPU_LIMIT=1.0

# ==============================================================================
# Docker Compose — Monitoring (Prometheus + Grafana)
# ==============================================================================

PROMETHEUS_VERSION=v2.54.1
PROMETHEUS_PORT=9090
PROMETHEUS_MEMORY_LIMIT=512M
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_RETENTION=30d

GRAFANA_VERSION=11.3.0
GRAFANA_PORT=3000
GRAFANA_MEMORY_LIMIT=256M
GRAFANA_CPU_LIMIT=0.25
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==============================================================================
# Arrow Lake — Storage (S3 / MinIO)
# ==============================================================================

# WARNING: Change credentials before deploying to any shared environment
ARROW_LAKE__STORAGE__BACKEND=minio
# NOTE: Inside Docker Compose, use service name 'http://minio:9000'
#       (docker-compose.yml x-arrow-lake-env overrides this automatically)
ARROW_LAKE__STORAGE__S3_ENDPOINT=http://localhost:9000
ARROW_LAKE__STORAGE__S3_ACCESS_KEY=<CHANGE_ME>
ARROW_LAKE__STORAGE__S3_SECRET_KEY=<CHANGE_ME>
ARROW_LAKE__STORAGE__S3_BUCKET=arrow-lake
ARROW_LAKE__STORAGE__S3_REGION=us-east-1

# ==============================================================================
# Arrow Lake — Compute
# ==============================================================================

ARROW_LAKE__COMPUTE__GPU_ENABLED=false
ARROW_LAKE__COMPUTE__RAY_ADDRESS=auto
ARROW_LAKE__COMPUTE__NUM_WORKERS=2

# ==============================================================================
# Arrow Lake — Observability
# ==============================================================================

ARROW_LAKE__OBSERVABILITY__METRICS_ENABLED=true
ARROW_LAKE__OBSERVABILITY__METRICS_PORT=8000
ARROW_LAKE__OBSERVABILITY__LOG_LEVEL=INFO
# ARROW_LAKE__OBSERVABILITY__CORRELATION_ID=  # auto-generated UUID if not set

# ==============================================================================
# Arrow Lake — HTTP
# ==============================================================================

ARROW_LAKE__HTTP__TIMEOUT_SECONDS=30.0
ARROW_LAKE__HTTP__MAX_RETRIES=3

# ==============================================================================
# Arrow Lake — Media
# ==============================================================================

ARROW_LAKE__MEDIA__THUMBNAIL_SIZE=64
ARROW_LAKE__MEDIA__PREVIEW_SIZE=512
ARROW_LAKE__MEDIA__MAX_IMAGE_DIMENSION=4096
ARROW_LAKE__MEDIA__RETENTION_ORIGINAL_DAYS=90

# ==============================================================================
# Arrow Lake — LLM (for RAG generation)
# ==============================================================================

# Provider: openai | anthropic | vllm | ollama | deepseek
ARROW_LAKE__LLM__PROVIDER=openai
ARROW_LAKE__LLM__MODEL=gpt-4o-mini
# ARROW_LAKE__LLM__API_KEY=<CHANGE_ME>
# ARROW_LAKE__LLM__API_BASE=  # empty = use provider default
ARROW_LAKE__LLM__TEMPERATURE=0.7
ARROW_LAKE__LLM__MAX_TOKENS=2048
ARROW_LAKE__LLM__TIMEOUT_SECONDS=60.0

# DeepSeek V4 example:
# ARROW_LAKE__LLM__PROVIDER=deepseek
# ARROW_LAKE__LLM__MODEL=deepseek-v4-flash
# ARROW_LAKE__LLM__API_KEY=<YOUR_DEEPSEEK_API_KEY>

# ==============================================================================
# Arrow Lake — Embedding
# ==============================================================================

ARROW_LAKE__EMBEDDING__MODEL=Qwen/Qwen3-Embedding-0.6B
ARROW_LAKE__EMBEDDING__BATCH_SIZE=128
ARROW_LAKE__EMBEDDING__BACKEND=local
# ARROW_LAKE__EMBEDDING__API_BASE=
# ARROW_LAKE__EMBEDDING__API_KEY=

# ==============================================================================
# Arrow Lake — Decode
# ==============================================================================

ARROW_LAKE__DECODE__QUALITY=full

# ==============================================================================
# Arrow Lake — Vector Search
# ==============================================================================

ARROW_LAKE__VECTOR__METRIC=cosine
ARROW_LAKE__VECTOR__DEFAULT_INDEX_TYPE=IVF_PQ
ARROW_LAKE__VECTOR__DEFAULT_TOP_K=10
ARROW_LAKE__VECTOR__NUM_PARTITIONS=256
ARROW_LAKE__VECTOR__NUM_SUB_VECTORS=24
ARROW_LAKE__VECTOR__NUM_BITS=8
ARROW_LAKE__VECTOR__NPROBES=20
# ARROW_LAKE__VECTOR__MAX_NPROBES=256

# ==============================================================================
# Arrow Lake — Full-Text Search
# ==============================================================================

ARROW_LAKE__FTS__DEFAULT_TOP_K=10
ARROW_LAKE__FTS__FTS_COLUMN=text_content
ARROW_LAKE__FTS__STEM=true
ARROW_LAKE__FTS__REMOVE_STOP_WORDS=true
ARROW_LAKE__FTS__LOWER_CASE=true

# ==============================================================================
# Arrow Lake — Hybrid Search
# ==============================================================================

ARROW_LAKE__HYBRID__DEFAULT_TOP_K=10
ARROW_LAKE__HYBRID__RRF_K=60
ARROW_LAKE__HYBRID__VECTOR_TOP_K_MULTIPLIER=3
ARROW_LAKE__HYBRID__FTS_TOP_K_MULTIPLIER=3

# ==============================================================================
# Arrow Lake — OLAP Analytics
# ==============================================================================

ARROW_LAKE__OLAP__MAX_RESULT_ROWS=100000
ARROW_LAKE__OLAP__ENABLE_PREDICATE_PUSHDOWN=true

# ==============================================================================
# Arrow Lake — Quality
# ==============================================================================

ARROW_LAKE__QUALITY__ENABLED=true
ARROW_LAKE__QUALITY__FILTER_MODE=all
ARROW_LAKE__QUALITY__ACTIVE_FILTERS=
ARROW_LAKE__QUALITY__SCHEMA_VALIDATION=lenient
ARROW_LAKE__QUALITY__DEAD_LETTER_ENABLED=true
ARROW_LAKE__QUALITY__TEXT_MIN_CHARS=1
# ARROW_LAKE__QUALITY__TEXT_MAX_CHARS=
ARROW_LAKE__QUALITY__IMAGE_MIN_WIDTH=64
ARROW_LAKE__QUALITY__IMAGE_MIN_HEIGHT=64

# ==============================================================================
# Arrow Lake — API Server
# ==============================================================================

ARROW_LAKE__API__API_KEY=
ARROW_LAKE__API__API_KEY_HEADER=X-API-Key
ARROW_LAKE__API__API_KEY_ROTATION_DAYS=90
ARROW_LAKE__API__AUTO_GENERATE_REQUEST_ID=true

# ==============================================================================
# Arrow Lake — Authentication (M4)
# ==============================================================================

# Auth mode: api_key | jwt | both
ARROW_LAKE__AUTH__AUTH_MODE=api_key
# ARROW_LAKE__AUTH__JWT_SECRET_KEY=<CHANGE_ME>
ARROW_LAKE__AUTH__JWT_ALGORITHM=HS256
ARROW_LAKE__AUTH__JWT_ACCESS_TOKEN_MINUTES=30
ARROW_LAKE__AUTH__JWT_REFRESH_TOKEN_DAYS=7
ARROW_LAKE__AUTH__JWT_ISSUER=arrow-lake

# ==============================================================================
# Arrow Lake — OpenTelemetry (M4, optional)
# ==============================================================================

# Enable OpenTelemetry tracing (requires: pip install arrow-lake[otel])
ARROW_LAKE__OPENTELEMETRY__ENABLED=false
# ARROW_LAKE__OPENTELEMETRY__SERVICE_NAME=arrow-lake
# ARROW_LAKE__OPENTELEMETRY__OTEL_ENDPOINT=http://localhost:4317
ARROW_LAKE__OPENTELEMETRY__TRACE_SAMPLE_RATE=1.0

# ==============================================================================
# Arrow Lake — Rate Limiting (M5, optional)
# ==============================================================================

# Enable rate limiting (requires: pip install slowapi)
ARROW_LAKE__RATE_LIMIT__ENABLED=false
ARROW_LAKE__RATE_LIMIT__DEFAULT_REQUESTS_PER_MINUTE=60
ARROW_LAKE__RATE_LIMIT__DEFAULT_BURST=10

# ==============================================================================
# Docker Compose — HugeGraph (Knowledge Graph)
# ==============================================================================

HUGEGRAPH_VERSION=1.7.0
HUGEGRAPH_PORT=8089
HUGEGRAPH_MEMORY_LIMIT=4G
HUGEGRAPH_CPU_LIMIT=2.0

# ==============================================================================
# Docker Compose — TurboOCR (requires GPU)
# ==============================================================================

TURBO_OCR_VERSION=latest
OCR_MAX_PAGES=100
OCR_MAX_FILE_SIZE_MB=50
OCR_WORKERS=2
OCR_MEMORY_LIMIT=2G
OCR_CPU_LIMIT=1.0
GPU_COUNT_FOR_OCR=1

# ==============================================================================
# Docker Compose — MinIO Client
# ==============================================================================

MINIO_MC_VERSION=latest
